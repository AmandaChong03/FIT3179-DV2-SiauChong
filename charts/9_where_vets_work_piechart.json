{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": [
      "3 in 4 vets work at an everyday local clinic"
    ],
    "subtitle": [
      "Share of 1,500 vets in clinical practice, by",
      "type of workplace, Australia, 2023/24"
    ],
    "anchor": "start",
    "fontSize": 17,
    "color": "#243238",
    "subtitleFontSize": 12,
    "subtitleColor": "#56616B",
    "offset": 14,
    "font": "Georgia, 'Times New Roman', serif",
    "subtitleFont": "Arial"
  },
  "width": 295,
  "height": 260,
  "data": {
    "url": "https://amandachong03.github.io/FIT3179-DV2-SiauChong/data/9_where_vets_work.csv",
    "format": {
      "parse": {
        "label_x": "number",
        "label_y": "number",
        "anchor_x": "number",
        "anchor_y": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "format(datum.percent_of_vets, '.1f') + '%'",
      "as": "percent_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "outerRadius": 120,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "percent_of_vets",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "slice_order",
          "type": "quantitative"
        },
        "color": {
          "field": "clinic_type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Everyday local clinics",
              "Specialist and emergency hospitals",
              "Mobile vets (home visits)",
              "Other"
            ],
            "range": [
              "#3978A8",
              "#8DB3CF",
              "#B7CEDF",
              "#D5DFE6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "clinic_type",
            "type": "nominal",
            "title": "Type of clinic"
          },
          {
            "field": "vets",
            "type": "quantitative",
            "title": "Vets"
          },
          {
            "field": "percent_of_vets",
            "type": "quantitative",
            "title": "Share of vets (%)",
            "format": ".1f"
          },
          {
            "field": "includes",
            "type": "nominal",
            "title": "Includes"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.anchor_x)"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#9aa5ad",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "anchor_x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "anchor_y",
          "type": "quantitative",
          "scale": null
        },
        "x2": {
          "field": "label_x",
          "offset": 4
        },
        "y2": {
          "field": "label_y"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.anchor_x)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 10,
        "color": "#243238",
        "dy": -1
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "clinic_type"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.anchor_x)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#243238",
        "dy": 1
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "percent_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!isValid(datum.anchor_x)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 22,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "percent_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!isValid(datum.anchor_x)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "fontSize": 10,
        "color": "white",
        "lineBreak": "|",
        "dy": 2
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "value": "Everyday|local clinics"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 10,
        "fontStyle":"italic",
        "color": "#56616B"
      },
      "encoding": {
        "x": {
          "value": -160
        },
        "y": {
          "value": 275
        },
        "text": {
          "value": [
            "Source: Australian Veterinary Association, Workforce",
            "Survey 2023/24, Figure 14."
          ]
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
