{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": [
      "Clinics with only one vet wait",
      "longest to fill a job"
    ],
    "subtitle": [
      "Each row shows job-filling time by clinic size.",
      "Data covers 2023/24; each row totals 100%."
    ],
    "anchor": "start",
    "fontSize": 17,
    "color": "#243238",
    "subtitleFontSize": 12,
    "subtitleColor": "#56616B",
    "offset": 14,
    "font": "Georgia, 'Times New Roman', serif",
    "subtitleFont": "Arial"
  },
  "width": 424,
  "height": 247,
  "data": {
    "url": "https://amandachong03.github.io/FIT3179-DV2-SiauChong/data/8_time_to_fill_by_clinic_size.csv"
  },
  "transform": [
    {
      "calculate": "'Clinics with ' + datum.clinic_size + '|' + datum.clinic_job_openings + ' job openings'",
      "as": "size_label"
    },
    {
      "calculate": "format(datum.percent_of_clinic_size, '.0f') + '%'",
      "as": "percent_label"
    }
  ],
  "layer": [
    {
      "encoding": {
        "x": {
          "field": "time_to_fill",
          "type": "ordinal",
          "sort": {
            "field": "time_order"
          },
          "axis": {
            "title": "How long the job took to fill →",
            "titleAnchor": "start",
            "titleFontSize": 10,
            "titleFontWeight": "bold",
            "titleColor": "#243238",
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 9,
            "labelColor": "#243238",
            "domain": false,
            "ticks": false,
            "labelPadding": 4
          }
        },
        "y": {
          "field": "size_label",
          "type": "ordinal",
          "sort": {
            "field": "size_order"
          },
          "axis": {
            "title": null,
            "labelExpr": "split(datum.value, '|')",
            "labelLineHeight": 13,
            "labelFontSize": 10,
            "labelColor": "#243238",
            "domain": false,
            "ticks": false
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "white",
            "strokeWidth": 2
          },
          "encoding": {
            "color": {
              "field": "percent_of_clinic_size",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  70
                ],
                "range": [
                  "#E6F1EF",
                  "#176273"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "clinic_size",
                "type": "nominal",
                "title": "Clinic size"
              },
              {
                "field": "time_to_fill",
                "type": "nominal",
                "title": "Time to fill"
              },
              {
                "field": "job_openings",
                "type": "quantitative",
                "title": "Job openings"
              },
              {
                "field": "percent_label",
                "type": "nominal",
                "title": "Share of this clinic size"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": {
              "field": "percent_label"
            },
            "color": {
              "condition": {
                "test": "datum.percent_of_clinic_size >= 60",
                "value": "white"
              },
              "value": "#243238"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#243238"
      },
      "encoding": {
        "x": {
          "value": -6
        },
        "y": {
          "value": 10
        },
        "text": {
          "value": "Clinic size"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 10,
        "color": "#243238",
        "lineBreak": "|"
      },
      "encoding": {
        "x": {
          "value": 434
        },
        "y": {
          "value": 15
        },
        "text": {
          "value": "7 in 10 jobs at|one-vet clinics|stayed empty for|over a year"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 10,
        "fontStyle":"italic",
        "color": "#56616B"
      },
      "encoding": {
        "x": {
          "value": -150
        },
        "y": {
          "value": 262
        },
        "text": {
          "value": [
            "Source: Australian Veterinary Association, Workforce Survey 2023/24,",
            "Table 11."
          ]
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
