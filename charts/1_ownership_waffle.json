{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": [
      "Pets live in nearly three-quarters of Australian homes."
    ],
    "subtitle": [
      "Each square represents one in 100 households, 2025."
    ],
    "anchor": "start",
    "fontSize": 17,
    "color": "#243238",
    "subtitleFontSize": 12,
    "subtitleColor": "#56616B",
    "offset": 14,
    "font": "Georgia, 'Times New Roman', serif",
    "subtitleFont": "Arial"
  },
  "data": {
    "url": "https://amandachong03.github.io/FIT3179-DV2-SiauChong/data/1_pet_ownership.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2025"
    },
    {
      "calculate": "sequence(0,100)",
      "as": "square"
    },
    {
      "flatten": [
        "square"
      ]
    },
    {
      "calculate": "datum.square % 10",
      "as": "column"
    },
    {
      "calculate": "floor(datum.square / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.square < datum.households_with_pets_percent?'Has a pet':'No pet'",
      "as": "status"
    },
    {
      "calculate": "datum.status == 'Has a pet' ? '73 in 100' : '27 in 100'",
      "as": "group_share"
    },
    {
      "calculate": "'1 in 100 households'",
      "as": "square_value"
    }
  ],
  "hconcat": [
    {
      "width": 300,
      "height": 300,
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "column",
          "type": "ordinal",
          "axis": {
            "title": "Source: Animal Medicines Australia, Pets in Australia 2025",
            "titleAnchor": "start",
            "titleFontSize": 10,
            "titleFontWeight": "normal",
            "titleColor": "#56616B",
            "titlePadding": 12,
            "titleFontStyle":"italic",
            "domain": false,
            "ticks": false,
            "labels": false
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "sort": "descending",
          "axis": null
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Has a pet",
              "No pet"
            ],
            "range": [
              "#176273",
              "#D9E0E2"
            ]
          },
          "legend": null
        }
      },
      "tooltip": [
        {
          "field": "status",
          "type": "nominal",
          "title": "Household"
        },
        {
          "field": "group_share",
          "type": "nominal",
          "title": "Group share"
        },
        {
          "field": "square_value",
          "type": "nominal",
          "title": "This square"
        }
      ]
    },
    {
      "width": 170,
      "height": 300,
      "data": {
        "values": [
          {}
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "color": "#176273"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "x2": {
              "value": 18
            },
            "y": {
              "value": 50
            },
            "y2": {
              "value": 68
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#56616B"
          },
          "encoding": {
            "x": {
              "value": 26
            },
            "y": {
              "value": 59
            },
            "text": {
              "value": "TEAL"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 34,
            "fontWeight": "bold",
            "color": "#176273"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 78
            },
            "text": {
              "value": "73 in 100"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 14,
            "lineHeight": 18,
            "lineBreak": "|",
            "color": "#243238"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 120
