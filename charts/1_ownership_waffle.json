          },
          "encoding": {
            "x": {
              "value": 16
            },
            "y": {
              "value": 195
            },
            "text": {
              "value": "PALE GREY"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 15,
            "fontWeight": "bold",
            "color": "#8A959A"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 208
            },
